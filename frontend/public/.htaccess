<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Permanent 301 redirects: legacy Spanish routes -> English canonical ---
  # Server-side so search engines and external links get a real 301 (better SEO
  # than the client-side redirects, which stay as an in-app fallback). Query
  # strings are preserved automatically.
  RewriteRule ^actividades/?$        /activities   [R=301,L]
  RewriteRule ^actividad/(.+)$       /activity/$1   [R=301,L]
  RewriteRule ^destinos/?$           /destinations [R=301,L]
  RewriteRule ^nosotros/?$           /about        [R=301,L]
  RewriteRule ^contacto/?$           /contact      [R=301,L]
  RewriteRule ^mi-cuenta/?$          /account      [R=301,L]
  RewriteRule ^acceso/?$             /login        [R=301,L]
  RewriteRule ^registro/?$           /register     [R=301,L]

  # Serve real files/directories (assets, sitemap.xml, robots.txt) directly
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # SPA fallback: send everything else to index.html so React Router handles it
  RewriteRule . /index.html [L]
</IfModule>

# --- Caching: hashed assets cached long, HTML always revalidated so new deploys
# show immediately (a new build changes the JS/CSS filenames). Note: SiteGround's
# server-side Dynamic Cache still needs a purge from Site Tools after each deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^service-worker\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
