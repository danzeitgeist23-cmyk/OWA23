# OWA Production Environment Template
# Copy to .env.production and fill in values
# NEVER commit real secrets to git!

# ========================================
# DATABASE
# ========================================
MONGO_URL=mongodb://mongodb:27017
DB_NAME=owa_db

# For MongoDB with auth (uncomment and set):
# MONGO_URL=mongodb://username:password@mongodb:27017/owa_db?authSource=admin

# ========================================
# CORS & SECURITY
# ========================================
CORS_ORIGINS=https://owawild.com,https://www.owawild.com

# ========================================
# JWT & AUTH (generate with: openssl rand -hex 32)
# ========================================
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ========================================
# EXTERNAL APIs (add as needed)
# ========================================
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# SENDGRID_API_KEY=SG....
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=eu-west-1

# ========================================
# MONITORING (optional)
# ========================================
# SENTRY_DSN=https://...
# LOG_LEVEL=INFO