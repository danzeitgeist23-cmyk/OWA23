# OWA SiteGround deploy credentials — TEMPLATE.
# Copy to scripts/deploy.env and fill in the real values. scripts/deploy.env is gitignored.

# --- FTPS (fallback, deploy-siteground.sh) ---
# From SiteGround Site Tools -> Site -> FTP Accounts.
FTP_HOST="ftp.your-domain.com"
FTP_USER="user@your-domain.com"
# Wrap the password in SINGLE quotes so $, backticks and other symbols stay literal.
FTP_PASS='replace-with-real-password'
FTP_PORT="21"
REMOTE_PATH="/your-domain.com/public_html"

# --- rsync over SSH (preferred, deploy-siteground-ssh.sh) ---
# 1. Authorize ~/.ssh/owa_siteground_deploy.pub in Site Tools -> Devs -> SSH Keys Manager.
# 2. Set SSH_HOST (usually ssh.<domain>), SSH_USER (the SSH username shown in the
#    SSH Keys Manager, e.g. u15-xxxx) and SSH_REMOTE_PATH (absolute path, confirm
#    with: ssh -p 18765 <user>@<host> 'ls -d ~/www/*/public_html').
SSH_HOST="ssh.your-domain.com"
SSH_PORT="18765"
SSH_USER=""
SSH_KEY="~/.ssh/owa_siteground_deploy"
SSH_REMOTE_PATH="/home/USER/www/your-domain.com/public_html"
