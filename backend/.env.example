# OWA Backend Local Development Environment
# Copy to backend/.env and fill in values

# ========================================
# DATABASE (Local MongoDB)
# ========================================
MONGO_URL=mongodb://localhost:27017
DB_NAME=owa_db

# ========================================
# CORS (Local frontend dev server)
# ========================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ========================================
# JWT & AUTH
# ========================================
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ========================================
# DEBUG
# ========================================
DEBUG=True
LOG_LEVEL=DEBUG

# ========================================
# SUMUP ONLINE PAYMENTS
# ========================================
# Configure these values only in the server environment. Never expose them
# through REACT_APP_* variables or commit real credentials.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_PAYMENTS_ENABLED=false
SUMUP_API_BASE_URL=https://api.sumup.com
SUMUP_HTTP_TIMEOUT_SECONDS=12

# Public URLs used by SumUp after checkout and for payment notifications.
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
